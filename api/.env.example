# 本番・共通向けの環境変数の見本。このファイルを api/.env にコピーして使う(.env はコミットしない)。
# ローカル開発では、代わりに api/.env.local を使う(見本は .env.local.example)。
# 読み込みの優先順位: シェルの環境変数 > .env.local > .env。.env.local の値が .env より優先される。
# 値はすべて空。説明は、ルートの README.md の「api/.env.local の設定」を見る。
# BETTER_AUTH_SECRET は openssl rand -hex 32 などで生成する(本番では必須)。
DATABASE_URL=
BETTER_AUTH_URL=
BETTER_AUTH_SECRET=
WEB_ORIGIN=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
RESEND_API_KEY=
MAIL_FROM=
# ファイル(プロダクトのアイコンなど)の保存先のフォルダ。ローカル(Bun)とテストだけで使う。本番(Workers)は R2 のバインディング STORAGE を使う。
# 既定は ./.local-storage(コミットしない)
# STORAGE_DIR=
# プロダクトのアイコンの公開 URL(R2 のバケットの公開 URL。末尾の / はあってもなくても良い)。本番(Workers)では wrangler.jsonc の vars に書く。
# 空のままにすると(ローカルとテスト)、アイコンは開発用の配信ルート /api/_dev-storage/<キー> から返す。設定すると、そのルートは登録されない
AVATAR_BASE_URL=
# タスクの自動割り振り(Jev。TypeSafe AI)。空なら、自動割り振りの API は 503 を返し、他の機能には影響しない。
# モデルの版 JEV_MODEL の既定は jev-1.14.0(jev-latest は中身が変わるので使わない)。docs/v3.0/jev-assign.md
TYPESAFE_API_KEY=
# JEV_MODEL=
# 案 D(web と api が同じ親ドメインのサブドメイン)のときだけ。例: .example.com。案 S(同一オリジン)では不要。
# COOKIE_DOMAIN=
