# このファイルを api/.env にコピーして使う(.env はコミットしない)。
# DATABASE_URL は docker compose の既定の値。空欄の変数の説明は、ルートの README.md の「api/.env の設定」を見る。
# BETTER_AUTH_SECRET は openssl rand -hex 32 などで生成する(開発では空でも起動するが、本番では必須)。
DATABASE_URL=postgres://postgres:postgres@localhost:5433/ningyoutukai
BETTER_AUTH_URL=http://localhost:3001
BETTER_AUTH_SECRET=
WEB_ORIGIN=http://localhost:3000
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
RESEND_API_KEY=
MAIL_FROM=
