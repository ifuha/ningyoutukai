# `wrangler dev`(ローカルの Workers)用の環境変数。コピーして `.dev.vars` にして使う(`.dev.vars` はコミットしない)。
# 本番のシークレットは入れない。外部(GitHub / Google / Resend)につなぐ値は、空のままで良い。
DATABASE_URL=postgres://postgres:postgres@localhost:5433/ningyoutukai
BETTER_AUTH_SECRET=dummy-secret-dummy-secret-dummy-secret
BETTER_AUTH_URL=http://localhost:8787
WEB_ORIGIN=http://localhost:3000
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# RESEND_API_KEY=
# MAIL_FROM=

# --- Containers の Postgres を Durable Object 経由で使うとき(wrangler.jsonc の PG_VIA_DO。docs/infra-do-container.md) ---
# DATABASE_URL は、ユーザー / パスワード / DB 名の指定にだけ使う(ホスト名は何でもよい)
# DATABASE_URL=postgres://postgres:postgres@do/ningyoutukai
# PG_PASSWORD=postgres                # コンテナの POSTGRES_PASSWORD(DATABASE_URL のパスワードと同じにする)
# PG_SLEEP_AFTER_SECONDS=600          # 接続が無いままこの秒数が過ぎたらコンテナを止める(データは消える)
# RESTORE_FROM_URL=                   # 起動時にダンプ(pg_dump -Fc)から復元するときの URL
